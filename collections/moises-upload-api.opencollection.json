{
  "opencollection": "1.0.0",
  "info": {
    "name": "Music AI Application Upload API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Upload",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request signed upload and download URLs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.music.ai/v1/upload"
          },
          "docs": "Returns a temporary `uploadUrl` (PUT your local file to it, hosted on Google Cloud Storage) and a `downloadUrl` you then pass as the job `inputUrl`."
        }
      ]
    }
  ],
  "bundled": true
}