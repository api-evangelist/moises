  "info": {
    "_postman_id": "15df33c6-ba85-43ee-8f19-9d5c8cd692ae",
    "name": "Music AI Application Workflows API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Music AI (the developer platform behind Moises) exposes AI audio models — stem separation, transcription, mastering, lyrics, chords, and more — as composable Modules assembled into Workflows and executed as asynchronous Jobs. Upload an audio file to temporary storage, create a Job against a Workflow, then poll for the result. Every request is authenticated with an API key in the Authorization header.\n\nContact Support:\n Name: Music AI Support\n Email: support@music.ai",
      "type": "text/plain"
    }
  }
